{% if message.role.value == 'assistant' %}
    {% set text = message.asText %}
    {% if text is not null %}
        {{ _self.bot(text, latest: latest) }}
    {% endif %}
{% else %}
    {{ _self.user(message.content) }}
{% endif %}

{% macro bot(content, loading = false, latest = false, contentId = null, messageId = null) %}
    <div class="message message-bot"{% if messageId %} id="{{ messageId }}"{% endif %}>
        <span class="bot avatar">{{ ux_icon('bot') }}</span>
        {% if loading %}
            <div class="bot-message loading">
                <span class="typing" aria-hidden="true"><span></span><span></span><span></span></span>
                <i>{{ content }}</i>
            </div>
        {% else %}
            <div class="bot-message"{% if contentId %} id="{{ contentId }}"{% endif %}>
                {% if latest and app.request.xmlHttpRequest %}
                    <span
                            data-controller="typed"
                            data-typed-strings-value="{{ [content|markdown_to_html]|json_encode|e('html_attr') }}"
                    ></span>
                {% else %}
                    {{ content|markdown_to_html }}
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% macro user(content, loading = false) %}
    <div class="message message-user">
        {% for item in content %}
            {% if loading %}
                <div class="user-message loading"><span class="typing" aria-hidden="true"><span></span><span></span><span></span></span> <i>{{ item.text }}</i></div>
            {% else %}
                <div class="user-message">{{ item.text }}</div>
            {% endif %}
        {% endfor %}
    </div>
{% endmacro %}

{% macro welcome(headline, text) %}
    <div id="welcome" class="message message-bot">
        <span class="bot avatar">{{ ux_icon('bot') }}</span>
        <div class="welcome-content">
            <h4>{{ headline }}</h4>
            <p>{{ text }}</p>
        </div>
    </div>
{% endmacro %}
