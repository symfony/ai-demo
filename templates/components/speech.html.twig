{% import '_message.html.twig' as msg %}

<section class="chat" {{ attributes.defaults(stimulus_controller('speech')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.speech }) }}
    <div id="chat-body" class="chat-body">
        {% for message in this.messages %}
            {% if 'user' == message.role.value %}
                {% include '_message.html.twig' with { message, latest: loop.last } %}
            {% else %}
                <div class="message message-bot">
                    <span class="bot avatar">{{ ux_icon('bot') }}</span>
                    <audio class="message-audio" controls {{ loop.last ? 'autoplay' }} src="{{ message.metadata.get('speech') }}"></audio>
                </div>
            {% endif %}
        {% else %}
            {{ msg.welcome('Speech Bot', 'Hit the button below to start talking, and again to stop. I transcribe what you say, ask my subagent about Symfony news if needed, and read the answer back to you.') }}
        {% endfor %}
        <div id="loading-message" class="d-none">
            {{ msg.user([{text:'Converting your speech to text ...'}], true) }}
            {{ msg.bot('The Bot is looking for an answer ...', true) }}
        </div>
    </div>
    <div class="chat-composer">
        <div class="chat-controls">
            <button id="micro-start" class="button button-primary button-lg" type="button">
                {{ ux_icon('microphone') }}
                Say something
            </button>
            <button id="micro-stop" class="button button-danger button-lg d-none" type="button">
                {{ ux_icon('microphone-mute') }}
                Stop
            </button>
            <button id="bot-thinking" class="button button-muted button-lg d-none" type="button" disabled>
                {{ ux_icon('timer') }}
                Bot is thinking
            </button>
        </div>
    </div>
</section>
