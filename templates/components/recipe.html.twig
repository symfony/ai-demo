{% import '_message.html.twig' as message %}
{% set idle = not this.awaitingRecipe and not this.recipe %}

<section class="chat" {{ attributes.defaults(stimulus_controller('recipe')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.recipe }) }}
    <div id="chat-body" class="chat-body position-relative">
        {# The recipe is streamed into #recipe-stream-target by Turbo, outside of the live component. Without
           data-skip-morph, a re-render (e.g. opening the share dialog) keeps those nodes and adds the rendered
           recipe next to them. #}
        {% if this.awaitingRecipe %}
            <div id="recipe-stream-target" data-skip-morph></div>
            <turbo-stream-source src="{{ path('recipe_assistant_reply') }}" id="recipe-stream-source"></turbo-stream-source>
            <div id="recipe-loader" class="recipe-loader">
                <div class="spinner-border text-primary mb-4" style="width: 60px; height: 60px;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="mb-2">The bot is cooking your recipe...</h4>
                <p class="text-muted small">This may take a moment</p>
            </div>
        {% elseif this.recipe %}
            <div id="recipe-stream-target" data-skip-morph>
                {{ include('components/_recipe_card.html.twig', { recipe: this.recipe }) }}
            </div>
        {% else %}
            {{ message.welcome('Cooking Recipes', 'Tell me what is in your fridge or what you feel like eating, and I propose a recipe - as structured output.') }}
        {% endif %}
    </div>
    <div id="recipe-share-overlay" class="share-overlay {{ this.shareOpen ? 'is-open' : '' }}">
        <div class="share-panel">
            <button class="share-close" {{ live_action('closeShare') }} aria-label="Close">×</button>
            <h4 class="mb-2">Share this recipe</h4>
            <p class="text-muted mb-3">Send the recipe to an email address.</p>
            <form class="input-group" {{ live_action('share:prevent') }}>
                <input
                    type="email"
                    class="form-control"
                    placeholder="Email address"
                    data-model="shareEmail"
                >
                <button class="btn btn-primary">
                    {{ ux_icon('email') }} Send
                </button>
            </form>
        </div>
    </div>
    <div class="chat-composer" data-controller="chat-prompt">
        {% if idle %}
            {{ include('_chat_prompts.html.twig', { prompts: ['Something quick with eggs and spinach', 'A vegan dinner for four', 'Fluffy pancakes for breakfast'] }) }}
        {% endif %}
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message" data-model="norender|message" type="text" class="chat-input" placeholder="What would you like to cook?" autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
