{% import '_message.html.twig' as message %}
{% set messages = this.messages %}

<section class="chat" {{ attributes.defaults(stimulus_controller('youtube')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.youtube }) }}
    <div id="chat-body" class="chat-body">
        {% for message in messages %}
            {% include '_message.html.twig' with { message, latest: loop.last } %}
        {% else %}
            <div id="welcome" class="message message-bot">
                <span class="bot avatar">{{ ux_icon('bot') }}</span>
                <div class="welcome-content">
                    <h4>Chat about a YouTube Video</h4>
                    <p>Enter the ID of a YouTube video, e.g. <code>6uXW-ulpj0s</code>, and I fetch its transcript so you can ask questions about it.</p>
                    <div class="welcome-form">
                        <form class="input-group" {{ live_action('start:prevent') }}>
                            <label class="input-group-text" for="youtube-id">youtube.com/watch?v=</label>
                            <input autofocus type="text" id="youtube-id"
                                   data-model="norender|videoId"
                                   class="form-control" placeholder="YouTube Video ID">
                            <button class="btn btn-primary" id="chat-start">Start</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div id="loading-message" class="d-none">
            {{ message.user([{text:''}]) }}
            {{ message.bot('The Youtube Bot is looking for an answer ...', true) }}
        </div>
    </div>
    <div class="chat-composer">
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input id="chat-message" {{ messages is empty ? 'disabled' }}
                   data-model="norender|message"
                   type="text" class="chat-input" placeholder="{{ messages is empty ? 'Start with a video ID first ...' : 'Ask about the video ...' }}" autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send" {{ messages is empty ? 'disabled' }}>{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
