{% import '_message.html.twig' as message %}
{% set messages = this.messages %}

<section class="chat" {{ attributes }}>
    {{ include('_chat_header.html.twig', { demo: demos.stream }) }}
    <div id="chat-body" class="chat-body">
        {% for message in messages %}
            {% include '_message.html.twig' with { message, latest: loop.last } %}
        {% endfor %}
        {% if this.stream %}
            {{ message.bot('Thinking...', contentId = 'bot-message-streamed') }}
            <turbo-stream-source src="{{ path('stream_assistant_reply') }}" id="bot-message-stream"></turbo-stream-source>
        {% endif %}
        {% if messages is empty %}
            {{ message.welcome('Turbo Stream Chat', 'My answers stream in token by token via Turbo Streams and server-sent events - ask me about the technologies used in this example.') }}
        {% endif %}
    </div>
    <div class="chat-composer" data-controller="chat-prompt">
        {% if messages is empty %}
            {{ include('_chat_prompts.html.twig', { prompts: ['Which technologies does this chat use?', 'Explain server-sent events', 'Write a haiku about PHP'] }) }}
        {% endif %}
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message" data-model="norender|message" type="text" class="chat-input" placeholder="Write a message ..." autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
