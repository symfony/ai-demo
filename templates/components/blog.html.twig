{% import '_message.html.twig' as message %}
{% set messages = this.messages %}

<section class="chat" {{ attributes.defaults(stimulus_controller('blog')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.blog }) }}
    <div id="chat-body" class="chat-body">
        {% for message in messages %}
            {% include '_message.html.twig' with { message, latest: loop.last } %}
        {% else %}
            {{ message.welcome('Retrieval Augmented Generation based on the Symfony blog', 'I answer questions based on the blog of symfony.com, which got indexed into a vector store - and link the posts I used as sources.') }}
        {% endfor %}
        <div id="loading-message" class="d-none">
            {{ message.user([{text:''}]) }}
            {{ message.bot('The Symfony Bot is looking for an answer ...', true) }}
        </div>
    </div>
    <div class="chat-composer" data-controller="chat-prompt">
        {% if messages is empty %}
            {{ include('_chat_prompts.html.twig', { prompts: ['What happened in the last Week of Symfony?', 'Which Symfony version is the latest?', 'When is the next SymfonyCon?'] }) }}
        {% endif %}
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message" data-model="norender|message" type="text" class="chat-input" placeholder="Ask about Symfony releases, features or events ..." autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
