<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Symfony AI Demo{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/ico" href="{{ asset('favicon.ico') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{{ block('body_class') }}">
        <header class="app-header">
            <a class="app-brand" href="{{ path('index') }}">
                {{ include('_logo.svg') }}
                <span class="app-brand-label">Demo</span>
            </a>
            <nav class="app-nav" aria-label="Examples">
                {% for route, demo in demos %}
                    {% if route == app.current_route %}
                        <a class="app-nav-link is-active" href="{{ path(route) }}" aria-current="page" style="--demo-gradient: {{ demo.gradient }}">{{ ux_icon(demo.icon) }}{{ demo.label }}</a>
                    {% else %}
                        <a class="app-nav-link" href="{{ path(route) }}">{{ ux_icon(demo.icon) }}{{ demo.label }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
            <a class="app-github" href="https://github.com/symfony/ai-demo" target="_blank" rel="noopener" aria-label="Symfony AI Demo on GitHub">{{ ux_icon('github') }}</a>
        </header>
        <main class="app-main">
            {% block content %}{% endblock %}
        </main>
    </body>
</html>
