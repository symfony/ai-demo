{% extends 'base.html.twig' %}

{% block body_class 'index' %}

{% block content %}
    <div class="index-content">
        <h1 class="index-title">{{ 'home.title_prefix'|trans }} <span>Symfony AI</span> {{ 'home.title_suffix'|trans }}</h1>
        <p class="index-intro">
            {{ 'home.intro'|trans }}
            Each example is one chatbot implemented in <code>src/**/Chat.php</code> - the AI configuration lives in
            <code>config/packages/ai.yaml</code>.
        </p>
        <div class="index-section-header">
            <h2 class="heading-accent">{{ 'home.examples'|trans }}</h2>
            <span class="eyebrow">{{ demos|length }} chatbots</span>
        </div>
        <div class="demo-grid">
            {% for route, demo in demos %}
                <article class="demo-card" style="--demo-gradient: {{ demo.gradient }}">
                    <div class="demo-card-media">
                        {{ ux_icon(demo.icon) }}
                        <span class="demo-tag">{{ demo.tag }}</span>
                    </div>
                    <div class="demo-card-body">
                        <h3 class="demo-card-title">{{ demo.name }}</h3>
                        <p class="demo-card-text">{{ demo.description }}</p>
                        <div class="demo-card-actions">
                            <a class="demo-card-link" href="{{ path(route) }}">Try it {{ ux_icon('arrow-up-right') }}</a>
                            {# Profiler route only available in dev #}
                            {% if 'dev' == app.environment %}
                                <a class="demo-card-source" href="{{ path('_profiler_open_file', { file: demo.source, line: demo.line }) }}">{{ ux_icon('code') }} Source</a>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
    <footer class="app-footer">
        Demo application for <a href="https://ai.symfony.com" target="_blank" rel="noopener">Symfony AI</a>
        &middot;
        Propose more examples on <a href="https://github.com/symfony/ai" target="_blank" rel="noopener">GitHub</a>
    </footer>
{% endblock %}
